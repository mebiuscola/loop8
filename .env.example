# Optional; UI settings are easier. Do not commit real credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Set false only when the provider does not support response_format JSON mode.
LLM_JSON_MODE=true
MINERU_API_TOKEN=
# Optional local recording upload limit in MB (1-8192).
CLASSROOM_AUDIO_LIMIT_MB=2048

# Optional installed/portable Edge or Chrome executable for page rendering.
CLASSROOM_BROWSER_PATH=
