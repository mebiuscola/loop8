      "refersTo": "library-card",
      "description": "Groups related materials on warm paper.",
      "html": "<section class=\"ds-card\"><div class=\"ds-card-label\">课程材料</div><div class=\"ds-file\"><span class=\"ds-file-type\">PDF</span><strong>Slides.pdf</strong></div></section>",
      "css": ".ds-card {background:var(--surface,#fefdf7);color:var(--ink,#222e2b);border:1px solid var(--line,#d7d9cf);border-radius:14px;padding:24px} .ds-card-label {color:var(--muted,#52615b);font-size:.75rem;font-weight:650;padding:4px 0 8px;border-bottom:1px solid var(--line,#d7d9cf)} .ds-file {display:flex;align-items:center;gap:12px;padding:11px 0;font-size:.875rem} .ds-file-type {display:grid;place-items:center;flex:0 0 35px;height:39px;background:#e2eee6;border:1px solid #ccdcd1;border-radius:8px;color:#345f52;font-size:.625rem;font-weight:700}"
